<Project Sdk="Microsoft.NET.Sdk">
    <ImportGroup>
        <Import Project="../CommonVersion.props" />
    </ImportGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LLServer</RootNamespace>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\LibreLancer.Base\LibreLancer.Base.csproj" />
        <ProjectReference Include="..\Librelancer.Database\LibreLancer.Database.csproj" />
        <ProjectReference Include="..\LibreLancer.Entities\LibreLancer.Entities.csproj" />
        <ProjectReference Include="..\LibreLancer\LibreLancer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <!-- Force patched native SQLite (>=3.50.2) over EF Core's transitive
             SQLitePCLRaw (bundled vulnerable SQLite 3.49.1 at EF 10.0.0) — fixes
             CVE-2025-6965 that upstream issue #420 tracks as still-open. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    </ItemGroup>
</Project>
